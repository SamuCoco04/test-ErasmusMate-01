generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  student
  coordinator
  administrator
}

enum SubmissionState {
  draft
  submitted
  in_review
  approved
  rejected
  reopened
  resubmitted
}

enum ExceptionState {
  submitted
  in_review
  approved
  rejected
}

enum SocialConnectionState {
  pending
  accepted
  rejected
  blocked
}

enum SocialContentType {
  recommendation
  opinion
}

enum SocialContentState {
  published
  hidden
  removed
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  createdAt       DateTime         @default(now())
  roleAssignments RoleAssignment[]
  mobilityRecords MobilityRecord[]
  submissions     Submission[]
  audits          SubmissionAuditEvent[]
  exceptions      ExceptionRequest[] @relation("RequesterExceptions")
  decidedExceptions ExceptionRequest[] @relation("DeciderExceptions")
  socialProfile   SocialProfile?
  sentMessages    Message[]        @relation("SentMessages")
  authoredContent SocialContent[]
  reports         ModerationReport[]
  favorites       Favorite[]
}

model RoleAssignment {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MobilityRecord {
  id          String       @id @default(cuid())
  studentId   String
  homeInstitution String
  hostInstitution String
  destination String
  state       String
  createdAt   DateTime     @default(now())
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id                String                 @id @default(cuid())
  mobilityRecordId  String
  studentId         String
  state             SubmissionState        @default(draft)
  draftPayload      Json?
  submittedAt       DateTime?
  decisionRationale String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  mobilityRecord    MobilityRecord         @relation(fields: [mobilityRecordId], references: [id], onDelete: Cascade)
  student           User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents         SubmissionDocument[]
  auditEvents       SubmissionAuditEvent[]
  exceptionRequests ExceptionRequest[]
}

model SubmissionDocument {
  id           String     @id @default(cuid())
  submissionId String
  name         String
  type         String
  url          String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model SubmissionAuditEvent {
  id           String     @id @default(cuid())
  submissionId String
  actorId      String
  eventType    String
  rationale    String?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model ExceptionRequest {
  id               String         @id @default(cuid())
  submissionId     String
  requesterId      String
  state            ExceptionState @default(submitted)
  scope            String
  rationale        String
  requestedEffect  String
  decisionRationale String?
  decidedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  submission       Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requester        User           @relation("RequesterExceptions", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy        User?          @relation("DeciderExceptions", fields: [decidedById], references: [id], onDelete: SetNull)
}

model SocialProfile {
  id            String             @id @default(cuid())
  userId         String             @unique
  displayName    String
  bio            String?
  discoverable   Boolean            @default(true)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingConnections SocialConnection[] @relation("OutgoingConnections")
  incomingConnections SocialConnection[] @relation("IncomingConnections")
  messagesSent   Message[]          @relation("ProfileMessages")
}

model SocialConnection {
  id                 String                @id @default(cuid())
  requesterProfileId String
  recipientProfileId String
  state              SocialConnectionState @default(pending)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  requester          SocialProfile         @relation("OutgoingConnections", fields: [requesterProfileId], references: [id], onDelete: Cascade)
  recipient          SocialProfile         @relation("IncomingConnections", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  messages           Message[]
}

model Message {
  id            String           @id @default(cuid())
  connectionId  String
  senderId      String
  senderProfileId String?
  body          String
  createdAt     DateTime         @default(now())
  connection    SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender        User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderProfile SocialProfile?   @relation("ProfileMessages", fields: [senderProfileId], references: [id], onDelete: SetNull)
}

model SocialContent {
  id          String             @id @default(cuid())
  authorId    String
  type        SocialContentType
  category    String
  title       String
  body        String
  state       SocialContentState @default(published)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  reports     ModerationReport[]
}

model ModerationReport {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  contentId  String?
  content    SocialContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}
